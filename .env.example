# No se usa: `make up` genera estado/.env (0600, fuera de git) desde credenciales.yaml (src/cauce/arranque/preparar.py).
# Este archivo solo documenta las claves de ese .env. Nunca se completa a mano.
PG_DATABASE=cauce_datos
PG_PORT=5432
PG_SUPERUSER=
PG_SUPERPASSWORD=
INGESTA_USER=
INGESTA_PASSWORD=
ANALISTA_USER=
ANALISTA_PASSWORD=
AUDITOR_USER=
AUDITOR_PASSWORD=
# Generadas una sola vez por `make up` (base64 de 32 bytes). Perderlas es perder la PII cifrada.
CAUCE_KEK=
CAUCE_K_BIDX=
